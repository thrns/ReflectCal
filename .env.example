# Server only. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=20000

# Server only Supabase project credentials. The service role key bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# All four quota values must be positive integers to enable live inference.
# Choose project-specific values; ReflectCal does not assume Google's free-tier limits.
GEMINI_DAILY_REQUEST_BUDGET=
GEMINI_MINUTE_REQUEST_BUDGET=
GEMINI_MINUTE_TOKEN_BUDGET=
PUBLIC_VISITOR_DAILY_EXPERIMENT_LIMIT=2
